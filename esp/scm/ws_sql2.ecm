ESPrequest ExecuteSQLRequest
{
    [rows(28), cols(80)] string SqlText;
};

ESPresponse [exceptions_inline] ExecuteSQLResponse
{
    string Result;
};

ESPrequest ListFilesRequest
{
    string Scope;
};

ESPresponse [exceptions_inline] ListFilesResponse
{
    string Scope;
    ESParray<string, File> Files;
};

ESPrequest DescribeFileRequest
{
    string LogicalName;
};

ESPStruct MetadataField
{
    string Path;
    string SourceType;
    string DuckDBType;
    boolean Fallback;
};

ESPStruct MetadataWarning
{
    string Code;
    string FieldPath;
    string Message;
};

ESPresponse [exceptions_inline] DescribeFileResponse
{
    boolean Resolved;
    string LogicalName;
    string Kind;
    string Format;
    integer NumParts;
    boolean Compressed;
    boolean BlockedCompression;
    boolean IsSuperfile;
    integer NumSubFiles;
    boolean IsKeyed;
    boolean MetadataSchemaUnbounded;
    integer RecordSize;
    string Owner;
    string Modified;
    string EclRecordDefinition;
    ESParray<ESPstruct MetadataField, Field> Fields;
    ESParray<ESPstruct MetadataWarning, Warning> Warnings;
};

ESPrequest ExplainScanRequest
{
    [rows(28), cols(80)] string SqlText;
};

ESPresponse [exceptions_inline] ExplainScanResponse
{
    boolean DataRead;
    string SqlText;
    ESParray<string, ResidualFilter> ResidualFilters;
};

ESPservice [version("1.0"), default_client_version("1.0"), auth_feature("WsSql2Access"), exceptions_inline("./smc_xslt/exceptions.xslt")] wssql2
{
    ESPmethod [] ExecuteSQL(ExecuteSQLRequest, ExecuteSQLResponse);
    ESPmethod [] ListFiles(ListFilesRequest, ListFilesResponse);
    ESPmethod [] DescribeFile(DescribeFileRequest, DescribeFileResponse);
    ESPmethod [] ExplainScan(ExplainScanRequest, ExplainScanResponse);
};