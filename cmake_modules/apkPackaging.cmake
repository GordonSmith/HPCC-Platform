function(hpcc_detect_apk_distribution result os_release_file)
    set(${result} FALSE PARENT_SCOPE)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT CMAKE_CROSSCOMPILING AND EXISTS "${os_release_file}")
        file(STRINGS "${os_release_file}" distro_id REGEX "^ID=")
        if(distro_id MATCHES "^ID=[\"']?(chainguard|wolfi)[\"']?$")
            set(${result} TRUE PARENT_SCOPE)
        endif()
    endif()
endfunction()
